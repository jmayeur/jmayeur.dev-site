{
  "routes": [
    {
      "route": "/.well-known/atproto-did",
      "headers": {
        "Content-Type": "text/plain"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/.well-known/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.ico",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.svg",
      "/*.webp",
      "/*.txt",
      "/*.map",
      "/assets/*"
    ]
  },
  "mimeTypes": {
    ".did": "text/plain"
  }
}
